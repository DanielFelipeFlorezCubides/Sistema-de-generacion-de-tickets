# ==========================================================
# VARIABLES DE ENTORNO - SISTEMA DE GESTIÓN DE TICKETS CON IA
# ==========================================================

# Puerto de escucha del servidor HTTP Express
PORT=3000

# Cadena de conexión a PostgreSQL para Prisma ORM
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tickets_db?schema=public"

# Integración con Google Gemini AI (dejar vacío para activar fallback local por reglas)
AI_API_KEY="tu_api_key_aqui"
AI_MODEL="gemini-1.5-flash"

# Clave secreta para la firma y verificación de tokens Bearer JWT
JWT_SECRET="supersecreto_jwt_para_firmar_tokens"
